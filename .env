# PENGATURAN VITE / REACT FRONTEND
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="AQPA Indonesia"

# ==========================================
# PENGATURAN BACKEND / LARAVEL (Jika Ada)
# ==========================================
APP_NAME="AQPA Indonesia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PENGATURAN POSTGRESQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_aqpa_indonesia
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
