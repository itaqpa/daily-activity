# PENGATURAN VITE / REACT FRONTEND
VITE_API_URL=http://localhost:8400/api
VITE_APP_NAME="AQPA Indonesia"

# ==========================================
# PENGATURAN BACKEND / LARAVEL (Jika Ada)
# ==========================================
APP_NAME="AQPA Indonesia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8400

# ==========================================
# PENGATURAN POSTGRESQL (DATABASE UTAMA / DAILY ACTIVITY)
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_aqpa_indonesia
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==========================================
# PENGATURAN POSTGRESQL (DATABASE 2: DRIVER APPS / LOGISTIK)
# ==========================================
DB_DRIVER_CONNECTION=pgsql
DB_DRIVER_HOST=127.0.0.1
DB_DRIVER_PORT=5432
DB_DRIVER_DATABASE=driver_apps
DB_DRIVER_USERNAME=postgres
DB_DRIVER_PASSWORD=postgres

# Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
