        <mxCell id="s9" value="&lt;b style=&quot;font-size:13px;color:#2c5356&quot;&gt;9. TINJAU LAPORAN AKHIR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Otomatis  ·  halaman Laporan, dibaca Admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dcebea;strokeColor=#3d6f73;strokeWidth=1.2;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
