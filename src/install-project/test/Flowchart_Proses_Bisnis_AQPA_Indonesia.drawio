<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="aqpa-flowchart" name="Flowchart Proses Bisnis AQPA">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_bg" value="&lt;font color=&quot;#ffffff&quot; style=&quot;font-size:22px&quot;&gt;&lt;b&gt;FLOWCHART PROSES BISNIS — INSTALLATION PROJECT AQPA INDONESIA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c5d4ea&quot; style=&quot;font-size:11px&quot;&gt;Sejalan dengan susunan halaman baru (Persiapan › Pelaksanaan › Hasil) dan skema SQL (16 tabel, 10 view)  |  warna = siapa yang mengisi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=none;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;MULAI&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#555555;strokeColor=#555555;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="125" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:13px;color:#1f3864&quot;&gt;1. SIAPKAN PENGGUNA &amp;amp; DATA PUBLIC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Diisi Admin  ·  sekali di awal, lalu saat ada perubahan  ·  berlaku untuk semua project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=top;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="960" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Akun pengguna&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nama, username, peran &lt;b&gt;admin&lt;/b&gt; atau &lt;b&gt;user&lt;/b&gt;.&lt;br&gt;Tandai &lt;b&gt;semua_project = 1&lt;/b&gt; untuk pengguna public: otomatis punya akses ke setiap project, termasuk project baru.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: users&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="262" width="300" height="122" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Data public: manpower, team, katalog scope&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Baris dengan &lt;b&gt;project_id kosong&lt;/b&gt; = public. Otomatis muncul di SEMUA project, termasuk yang baru diregistrasikan, tanpa perlu disalin.&lt;br&gt;Rate manpower public berlaku sama di semua project.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: manpower, work_groups, scope_catalog&lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:9px&quot;&gt;  (project_id = NULL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="262" width="600" height="122" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:13px;color:#1f3864&quot;&gt;2. REGISTER PROJECT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Diisi Admin  ·  halaman Register Project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#1f3864;strokeWidth=1.2;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="450" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="b_reg" value="&lt;b&gt;Status: REGISTERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8D5F5;strokeColor=#7B2D8E;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="468" width="160" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s2d" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Data registrasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No Project (unik), nama, customer, lokasi, leader, tanggal mulai, durasi, nilai kontrak, budget biaya, catatan.&lt;br&gt;Target selesai dihitung otomatis.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: projects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="425" width="280" height="116" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:13px;color:#1f3864&quot;&gt;3. LENGKAPI MASTER DATA PROJECT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Diisi Admin  ·  halaman Master Data  ·  yang tersedia di project = data public + data khusus project ini&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=top;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="960" height="292" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="&lt;b style=&quot;color:#1f3864&quot;&gt;A. Tim pengisi project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pengguna yang dikhususkan untuk project ini, dengan hak &lt;b&gt;edit&lt;/b&gt; atau &lt;b&gt;lihat&lt;/b&gt;. Admin dan pengguna public tidak perlu didaftarkan.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: project_members&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="126" y="650" width="215" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s3b" value="&lt;b style=&quot;color:#1f3864&quot;&gt;B. Manpower &amp;amp; rate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nama, posisi (Leader / Welder / Teknisi / Helper / HSE), rate per jam.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: manpower&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="357" y="650" width="215" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s3c" value="&lt;b style=&quot;color:#1f3864&quot;&gt;C. Group / team kerja&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hanya &lt;b&gt;nama&lt;/b&gt; team. Anggotanya per tanggal diisi User di Input Harian.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: work_groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="588" y="650" width="215" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s3d" value="&lt;b style=&quot;color:#1f3864&quot;&gt;D. Katalog scope of work&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nama tahapan pekerjaan yang menjadi pilihan di Rencana Kerja.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: scope_catalog&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="819" y="650" width="215" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s3_src" value="&lt;b&gt;Sumber data&lt;br&gt;B, C, dan D:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="126" y="792" width="130" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s3p" value="&lt;b style=&quot;color:#2c5356&quot;&gt;Sudah public&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Otomatis muncul. Tidak ada yang perlu dilakukan.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f2f8f7;strokeColor=#3d6f73;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="262" y="792" width="258" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s3k" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Belum ada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tambah baru sebagai &lt;b&gt;khusus&lt;/b&gt; project ini (project_id terisi). Tidak terlihat di project lain.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="532" y="792" width="258" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s3s" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Ada di project lain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Salin&lt;/b&gt; ke project ini. Asalnya tercatat di kolom disalin_dari_id.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="802" y="792" width="258" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:13px;color:#1f3864&quot;&gt;4. SUSUN RENCANA KERJA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;Diisi Admin  ·  halaman Rencana Kerja  ·  satu halaman bertingkat: Area › Unit › Scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#1f3864;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=top;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="932" width="960" height="206" as="geometry" />
        </mxCell>
        <mxCell id="s4a" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Area&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nama area dan bobot area.&lt;br&gt;Total semua area = 100%.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: areas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="126" y="992" width="215" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4b" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Unit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nama unit, bobot dalam area, target start &amp;amp; finish, team pelaksana (public atau khusus project ini).&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: units&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="357" y="992" width="215" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4c" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Scope per unit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pilih dari katalog scope, isi bobot dalam unit. Bisa disalin dari unit lain.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: unit_scopes&lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:9px&quot;&gt; (planned)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="588" y="992" width="215" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4d" value="&lt;b style=&quot;color:#2c5356&quot;&gt;Bobot thd project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dihitung otomatis:&lt;br&gt;= bobot area × bobot unit × bobot scope&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;View: v_capaian_scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f2f8f7;strokeColor=#3d6f73;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="819" y="992" width="215" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e4ab" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4a" target="s4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4bc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f3864;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4b" target="s4c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4cd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3d6f73;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s4c" target="s4d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Rencana lengkap?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;bobot tiap tingkat 100%,&lt;br&gt;team &amp;amp; target terisi&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="1180" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:13px;color:#1f3864&quot;&gt;5. MULAI PROJECT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Diisi Admin  ·  tombol Mulai (Running) di Register Project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#1f3864;strokeWidth=1.2;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="1352" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="b_run" value="&lt;b&gt;Status: RUNNING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#0f6e56;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="1370" width="160" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s5d" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Yang berubah&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;status menjadi &lt;b&gt;running&lt;/b&gt;, started_at terisi tanggal hari itu.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: projects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="1340" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a6500;strokeWidth=2;dashed=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="100" y="1466" width="960" height="640" as="geometry" />
        </mxCell>
        <mxCell id="loop_l" value="&lt;b style=&quot;font-size:12px;color:#7a5000&quot;&gt;SIKLUS HARIAN  ·  berulang setiap hari kerja selama project berstatus Running&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="1472" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:13px;color:#7a5000&quot;&gt;6. INPUT HARIAN  —  pilih satu tanggal kerja, lalu isi tiga hal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Diisi User  ·  halaman Input Harian  ·  hanya pengguna di tim pengisi project (project_members) atau pengguna public; hak &lt;b&gt;lihat&lt;/b&gt; tidak bisa mengisi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#9a6500;strokeWidth=1.2;fontColor=#1a1a1a;fontSize=11;align=center;verticalAlign=middle;spacing=6;spacingLeft=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="1504" width="920" height="62" as="geometry" />
        </mxCell>
        <mxCell id="s6a" value="&lt;b style=&quot;color:#7a5000&quot;&gt;a. Anggota group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Centang siapa saja yang bekerja di tiap team pada tanggal itu. Berlaku terus sampai diubah, jadi cukup disimpan saat komposisi berubah. Dicatat per project.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: group_rosters, group_roster_members&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fffbea;strokeColor=#9a6500;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="120" y="1590" width="296" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s6b" value="&lt;b style=&quot;color:#7a5000&quot;&gt;b. Progress &amp;amp; jam kerja&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pilih area dan unit, isi jam kerja dan % capaian hari itu per scope (tambahan, bukan kumulatif). Pekerjaan di luar rencana ditambah sebagai &lt;b&gt;additional job&lt;/b&gt; tanpa mengubah bobot.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: daily_hours, daily_progress, unit_scopes&lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:9px&quot;&gt; (additional)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fffbea;strokeColor=#9a6500;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="432" y="1590" width="296" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s6c" value="&lt;b style=&quot;color:#7a5000&quot;&gt;c. Biaya proyek&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kategori (akomodasi, hotel, transportasi, consumable), keterangan, jumlah. Dibebankan prorata ke semua unit atau langsung ke satu unit.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: project_costs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fffbea;strokeColor=#9a6500;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
