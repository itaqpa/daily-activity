        <mxCell id="s9d" value="&lt;b style=&quot;color:#2c5356&quot;&gt;Yang ditinjau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Plan vs actual: durasi, progress, biaya terhadap budget, additional job. Simpan summary bila perlu arsip.&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:10px&quot;&gt;Tabel: saved_reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f2f8f7;strokeColor=#3d6f73;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
