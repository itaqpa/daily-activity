          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chg" value="&lt;b style=&quot;color:#1f3864&quot;&gt;Bila rencana berubah di tengah jalan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Admin mengubah Rencana Kerja (atau Master Data), lalu menekan &lt;b&gt;Simpan versi&lt;/b&gt; supaya perubahannya tercatat. Input harian yang sudah ada tidak berubah.&lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#444444&quot; style=&quot;font-size:9px&quot;&gt;  Tabel: versions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1f3864;strokeWidth=1;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=top;spacing=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1">
